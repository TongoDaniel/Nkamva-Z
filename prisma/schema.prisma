// ==========================================================================
// Signalements (décision 7 — périmètre Modération)
// ==========================================================================
// Un seul modèle générique plutôt qu'un signalement par surface : la
// Modération doit pouvoir répondre à « montre-moi tout ce qui est signalé »,
// ce qu'une table par surface interdit.
//
// `targetId` n'est volontairement **pas** une clé étrangère : les cibles
// vivent dans des tables différentes, et certaines n'existent pas encore
// (MESSAGE attend la messagerie). La résolution du libellé se fait à la
// lecture, et une cible introuvable s'affiche comme telle.

enum ReportTargetType {
  COURSE
  USER
  COMMUNITY
  MESSAGE
  DISPUTE_MESSAGE
}

enum ReportReason {
  ILLEGAL
  MISLEADING
  HARASSMENT
  SPAM
  INTELLECTUAL_PROPERTY
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  detail       String?
  status       ReportStatus     @default(OPEN)
  /**
   * Renseigné à la clôture : ce que la Modération a fait, en clair.
   */
  decisionNote String?
  /**
   * La ressource a-t-elle été retirée du catalogue à la clôture ?
   */
  targetHidden Boolean          @default(false)
  reviewedById String?
  reviewedBy   User?            @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// ==========================================================================
// Tarification de l'abonnement plateforme (décisions 56, 57, 59, 61, 62)
// ==========================================================================
// Le tarif vit en base et il est daté : la gratuité de lancement n'est pas un
// cas particulier codé en dur, c'est un tarif à 0 avec une date de fin.

enum TariffKind {
  /// Abonnement du formateur à la plateforme (décisions 49, 59).
  SUBSCRIPTION
  /// Palier de 50 Go de stockage au-delà des 40 Go inclus (arbitrages 54, 69).
  STORAGE_TIER
}

model PlatformTariff {
  id          String      @id @default(uuid())
  /// Ce que ce tarif facture. Sans lui, une requête de tarif d'abonnement
  /// pourrait rendre le prix d'un palier de stockage — les deux vivent dans la
  /// même table parce qu'ils suivent la même règle : administrés, datés,
  /// jamais réécrits (décision 59).
  kind        TariffKind  @default(SUBSCRIPTION)
  cadence     PlanCadence
  amountFcfa  Int
  /**
   * Fenêtre de validité. `validUntil` nul = tarif courant.
   */
  validFrom   DateTime    @default(now())
  validUntil  DateTime?
  label       String?
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([kind, cadence, validFrom])
  @@map("platform_tariffs")
}

enum DiscountKind {
  CAMPAIGN
  TRAINER
  PROMO_CODE
}

// Décision 62 — trois canaux, un seul résultat : le montant consenti. Décision
// de cumul : **la plus favorable l'emporte**, elles ne s'additionnent jamais.
model PlatformDiscount {
  id          String       @id @default(uuid())
  kind        DiscountKind
  label       String
  /**
   * Montant retiré, en FCFA. Le pourcentage n'est qu'un affichage (décision 57).
   */
  amountFcfa  Int
  /**
   * PROMO_CODE uniquement — saisi par le formateur à la souscription.
   */
  code        String?      @unique
  /**
   * TRAINER uniquement — remise négociée, toujours motivée.
   */
  trainerId   String?
  reason      String?
  validFrom   DateTime     @default(now())
  validUntil  DateTime?
  maxUses     Int?
  usedCount   Int          @default(0)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, validFrom])
  @@index([trainerId])
  @@map("platform_discounts")
}

// ==========================================================================
// Cycle de vie de l'abonnement formateur (décisions 52, 56, 61, 68, 70)
// ==========================================================================
// Une ligne par période facturée. Le montant y est figé (décision 57) : le
// tarif change, une période déjà ouverte ne change pas avec lui.

enum SubscriptionChargeStatus {
  DUE
  SETTLED
  WAIVED
}

model SubscriptionCharge {
  id             String                   @id @default(uuid())
  trainerId      String
  trainerProfile TrainerProfile           @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  cadence        PlanCadence
  periodStart    DateTime
  periodEnd      DateTime
  listPriceFcfa  Int
  discountFcfa   Int                      @default(0)
  discountLabel  String?
  /// Paliers de stockage facturés sur cette période, et leur montant. Figés
  /// comme le reste : réduire ses paliers ne réécrit pas une période ouverte.
  storageTiers   Int                      @default(0)
  storageFcfa    Int                      @default(0)
  amountDueFcfa  Int
  status         SubscriptionChargeStatus @default(DUE)
  settledAt      DateTime?
  invoice        Invoice?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Idempotence du job de renouvellement : rejouer un tour ne peut pas
  // facturer deux fois la même période.
  @@unique([trainerId, periodStart])
  @@index([status, periodEnd])
  @@map("subscription_charges")
}
