// ==========================================================================
// NkamVa — Schéma Prisma complet (PostgreSQL) — Lots 0, 1, 2, 3, 4
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // L'application lit par le pooler ; les migrations, elles, ont besoin d'une
  // connexion directe : pgbouncer ne tient pas les verrous d'avis de Prisma.
  url       = env("DATABASE_URL")
  // Commentée, cette ligne ne rendait pas la main : `migrate` repassait par le
  // pooler de transactions et attendait indéfiniment un verrou d'avis que
  // pgbouncer ne peut pas tenir. Le symptôme n'est pas une erreur, c'est un
  // processus qui ne s'arrête jamais — d'où les `migrate deploy` fantômes.
  directUrl = env("DIRECT_URL")
}

// --- Enums ---
// Arbitrage 63 — deux sanctions distinctes, pas un booléen.
// RESTRICTED écarte la parole sans retirer l'accès (même patron que le membre
// banni d'une communauté) ; BANNED coupe la connexion ET l'accès aux ressources
// déjà payées, ce qui peut légitimement produire un litige — d'où sa réserve au
// Super-admin.
enum SanctionLevel {
  NONE
  RESTRICTED
  BANNED
}

// Arbitrage 47 — les deux circuits sont exclusifs. Une ressource est SOIT
// incluse dans une communauté (gratuite pour ses membres), SOIT vendue à
// l'unité. Jamais les deux : un membre ne peut donc jamais avoir « payé pour
// rien » une ressource que son abonnement lui aurait donnée.
enum CourseCircuit {
  MARKETPLACE
  COMMUNITY
}

enum Role {
  LEARNER
  PENDING_TRAINER
  TRAINER
  ADMIN
}

enum AdminRole {
  SUPER_ADMIN
  FINANCES
  MODERATION
}

// Décision 49 — un seul abonnement plateforme, deux cadences aux droits
// identiques. Les trois paliers STARTER/PRO/EXPERT n'ont plus d'objet : la
// seule restriction est le stockage (décision 54).
enum PlanCadence {
  MONTHLY
  YEARLY
}

enum TrainerSubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  PAWAPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
  CANCELED
}

enum CommunitySubscriptionStatus {
  ACTIVE
  PAST_DUE
  BANNED
  CANCELED
  EXPIRED
}

/// Arbitrage 81. PRIVATE sort la communauté de l'annuaire, de la recherche, de
/// la fiche formateur et de sa propre page publique — et révoque, à la bascule,
/// les liens partageables en circulation.
enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

/// Forme de l'invitation — comment elle circule (arbitrage 71).
enum InvitationKind {
  /// Adressée à une adresse e-mail, consommable une seule fois.
  NOMINATIVE
  /// Lien à copier, plusieurs acceptations, plafonné et daté. Jamais sur une
  /// communauté privée (arbitrage 74).
  SHARE_LINK
}

/// Nature de l'invitation — ce qu'elle ouvre (arbitrages 72 et 73).
///
/// La forme et la nature sont deux attributs distincts : le nominatif porte les
/// deux natures. Les confondre rendrait toute communauté privée gratuite à vie,
/// puisqu'elle ne s'entre qu'au nominatif.
enum InvitationGrant {
  /// 1 à 3 mois offerts. Réservée à la forme nominative.
  GIFT
  /// Mène au tunnel d'adhésion, au tarif de la communauté.
  PAID
}

enum InvitationIssuerRole {
  TRAINER
  MEMBER
}

enum PayoutMethodType {
  BANK_IBAN
  MOBILE_MONEY
}

enum AccountNature {
  INDIVIDUAL
  BUSINESS
}

/// Wave n'y figure pas : il n'est pas distribué par PawaPay, et un moyen de
/// versement Wave ne pouvait jamais être servi autrement qu'à la main.
enum MobileMoneyOperator {
  ORANGE_MONEY
  MTN_MOMO
  AIRTEL_MONEY
  M_PESA
}

enum VerificationMethod {
  NAME_LOOKUP
  MANUAL_FINANCE
  MICRO_DEPOSIT
  ESCALATION
}

enum PayoutMethodVerificationStatus {
  PENDING_REVIEW
  AUTO_VERIFIED
  MANUAL_VERIFIED
  VERIFIED
  REJECTED
  BLOCKED
  ARCHIVED
}

enum PayoutStatus {
  PENDING
  AUTO_APPROVED
  IN_REVIEW
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum TrainerDocumentType {
  ID_CARD
  DIPLOMA
  VIDEO
}

enum TrainerDocumentStatus {
  AWAITING_UPLOAD
  PENDING
  APPROVED
  REJECTED
  RESUBMITTED
}

enum TrainerApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMISSION_PENDING
}

enum DisputeSource {
  LEARNER_REQUEST
  STRIPE_CHARGEBACK
  PAWAPAY_DISPUTE
  ADMIN_INITIATED
}

enum DisputeReason {
  CONTENT_MISMATCH
  DOUBLE_CHARGE
  ACCESS_ISSUE
  UNAUTHORIZED_CHARGE
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  WAITING_LEARNER
  RESOLVED_REFUNDED
  RESOLVED_REJECTED
  RESOLVED_AUTO
}

enum DisputeResolution {
  FULL_REFUND
  PARTIAL_REFUND
  REJECT
  AUTO_TIMEOUT
}

enum DisputeMessageAuthorRole {
  LEARNER
  SUPPORT
  SYSTEM
}

enum FundReservationStatus {
  ACTIVE
  RELEASED
  DEBITED
  PARTIALLY_DEBITED
}

// --- User ---
model User {
  id                         String                  @id @default(uuid())
  email                      String                  @unique
  emailVerifiedAt            DateTime?
  passwordHash               String?
  googleSub                  String?                 @unique
  fullName                   String?
  preferredName              String?
  phone                      String?
  countryCode                String?
  /// Photo posée ailleurs qu'ici — une adresse, pas une clé de stockage. Reste
  /// pour les comptes d'essai et pour une éventuelle photo venue de Google ;
  /// `avatarS3Key` la couvre dès qu'une photo a été déposée.
  avatarUrl                  String?
  /// La photo de profil déposée sur R2. Servie par `/api/media/users/[id]/avatar`,
  /// qui redirige vers une URL signée — la clé ne sort jamais du serveur.
  ///
  /// Sans `sizeBytes` associé, contrairement aux couvertures : le quota de
  /// l'arbitrage 54 pèse les contenus **publiés** d'un formateur, et un portrait
  /// de 512 px n'en est pas un. Un apprenant n'a d'ailleurs aucun quota où le
  /// compter.
  avatarS3Key                String?
  bio                        String?
  role                       Role                    @default(LEARNER)
  adminRole                  AdminRole?
  payoutMethodRejectionCount Int                     @default(0)
  trainerApplications        TrainerApplication[]
  trainerProfile             TrainerProfile?
  courseViews                CourseView[]
  suspendedAt                DateTime?
  suspendedReason            String?
  sanctionLevel              SanctionLevel           @default(NONE)
  sanctionReason             String?
  sanctionedAt               DateTime?
  sanctionedById             String?
  suspendedById              String?
  sessionsValidAfter         DateTime                @default(now())
  /// Secret TOTP, chiffré au repos. Nul tant que la double authentification
  /// n'est pas activée — un secret sans `twoFactorEnabledAt` est un secret en
  /// cours d'enrôlement, qui ne protège rien encore.
  twoFactorSecret            String?
  twoFactorEnabledAt         DateTime?
  recoveryCodes              RecoveryCode[]
  /// Emails d'information sur l'abonnement formateur : annonce d'un changement
  /// de grille tarifaire, et rappel à l'échéance qui l'applique. Désactivable
  /// depuis « Profil & paramètres ».
  ///
  /// Ne couvre **pas** les emails dont le compte a besoin pour fonctionner —
  /// code de vérification, facture, impayé, litige, suppression de compte. Un
  /// réglage capable de les éteindre transformerait une préférence de confort
  /// en perte de droits, et le formateur découvrirait sa suspension sans avoir
  /// jamais été prévenu. La notification in-app, elle, part toujours : c'est la
  /// trace, l'email n'est que le porte-voix.
  subscriptionNoticeEmails   Boolean                 @default(true)
  /// Emails de la vie relationnelle (arbitrage 119) : nouveau message,
  /// invitation acceptée. Désactivable depuis « Profil & paramètres ».
  ///
  /// La seconde et **dernière** préférence d'email. Les cinq événements de
  /// F12.5 se rangent en deux catégories, pas cinq : ce qui est relationnel se
  /// coupe d'un geste, et ce qui est transactionnel — un reçu, une facture, un
  /// accès qui s'ouvre — ne se coupe pas du tout, parce que ce sont des preuves
  /// et non des annonces. Un écran de réglages avec un interrupteur par
  /// événement serait pire que le problème qu'il prétend résoudre.
  relationalEmails           Boolean                 @default(true)
  gdprExportRequestedAt      DateTime?
  gdprExportS3Key            String?
  deletionRequestedAt        DateTime?
  deletedAt                  DateTime?
  purchases                  Purchase[]
  communitySubscriptions     CommunitySubscription[]
  notifications              Notification[]
  favorites                  Favorite[]
  communityPosts             CommunityPost[]
  communityPostReplies       CommunityPostReply[]
  conversations              Conversation[]
  messagesSent               Message[]
  liveParticipations         LiveParticipant[]
  liveMessages               LiveMessage[]
  invoices                   Invoice[]
  disputesAsLearner          Dispute[]
  supportTickets             SupportTicket[]
  reportsFiled               Report[]                @relation("ReportsFiled")
  reportsReviewed            Report[]                @relation("ReportsReviewed")
  emailOtps                  EmailOtp[]
  conversationReads          ConversationRead[]
  invitationsIssued          CommunityInvitation[]   @relation("InvitationsIssued")
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([role])
  @@index([adminRole])
  @@index([suspendedAt])
  @@map("users")
}

// --- TrainerProfile ---
model TrainerProfile {
  id                           String                    @id @default(uuid())
  userId                       String                    @unique
  user                         User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  slogan                       String?
  description                  String?
  websiteUrl                   String?
  domains                      String[]
  experienceYears              Int?
  verifiedLegalName            String?
  commissionRate               Float                     @default(0.15)
  subscriptionCadence          PlanCadence               @default(MONTHLY)
  /**
   * Prix réellement consenti, snapshoté à la souscription (décision 57).
   */
  subscriptionPriceFcfa        Int?
  subscriptionDiscountFcfa     Int                       @default(0)
  /**
   * Cadence souhaitée au prochain renouvellement (décision 52).
   */
  pendingCadence               PlanCadence?
  /**
   * Renouvellement automatique — arbitrage 8. **Inactif par défaut** : le
   * formateur l'active lui-même, et son échéance est alors prélevée sur son
   * solde retirable.
   *
   * ⚠️ Ce drapeau ne gouverne **que** le renouvellement. La dette d'une période
   * consommée est récupérée sur le solde à la résiliation même s'il vaut faux
   * (arbitrage 10) : la période a été servie, elle se paie.
   */
  autoRenew                    Boolean                   @default(false)
  subscriptionStatus           TrainerSubscriptionStatus @default(ACTIVE)
  subscriptionProvider         PaymentProvider?
  subscriptionProviderId       String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCanceledAt       DateTime?
  /**
   * Début de l'impayé — sert à compter le délai de grâce avant suspension
   * (décision 68). Remis à null dès que la période est réglée.
   */
  subscriptionPastDueAt        DateTime?
  /// Paliers de 50 Go achetés au-delà des 40 Go inclus (arbitrage 69).
  storageTiers                 Int                       @default(0)
  subscriptionCharges          SubscriptionCharge[]
  subscriptionPayments         SubscriptionPayment[]
  wallet                       Wallet?
  ratingAverage                Float                     @default(0)
  ratingCount                  Int                       @default(0)
  studentsCount                Int                       @default(0)
  approvedAt                   DateTime?
  suspendedAt                  DateTime?
  suspendedReason              String?
  courses                      Course[]
  purchasesAsTrainer           Purchase[]
  payouts                      Payout[]
  payoutMethods                PayoutMethod[]
  communities                  Community[]
  conversations                Conversation[]
  liveSessions                 LiveSession[]
  replays                      Replay[]
  disputesAsTrainer            Dispute[]
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  @@index([subscriptionCadence])
  @@index([subscriptionStatus])
  @@map("trainer_profiles")
}

// --- Course ---
model Course {
  id               String            @id @default(uuid())
  trainerId        String
  trainerProfile   TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  slug             String            @unique
  title            String
  blurb            String
  description      String
  learnPoints      String[]
  includes         String[]
  category         String
  format           String
  coverS3Key       String?
  coverSizeBytes   BigInt?
  // Contenu réellement vendu. Sans ces trois champs, la clé servie à l'acheteur
  // était devinée (`course-content/{id}/main.mp4`) et ne correspondait à aucun
  // objet téléversé : le formateur déposait ailleurs, l'apprenant recevait une
  // URL signée vers du vide.
  contentS3Key     String?
  contentSizeBytes BigInt?
  contentMimeType  String?
  priceFcfa        Int
  level            String?
  language         String            @default("fr")
  /// F3.8 — **mesurée** sur le fichier à la confirmation du téléversement, plus
  /// jamais saisie. Réécrite à chaque dépôt, `null` compris : elle décrit le
  /// fichier présent, pas celui qu'il a remplacé. Nulle hors vidéo.
  ///
  /// `lessonsCount` a vécu à côté d'elle et a été retiré : une ressource est un
  /// fichier unique, rien dans le système ne pouvait confronter le nombre de
  /// sessions annoncé au contenu réel.
  durationSeconds  Int?
  /// F3.1 — le pendant documentaire de `durationSeconds`, mesuré au même
  /// moment et pour la même raison : la position de lecture d'un PDF est une
  /// **page**, et un pourcentage n'a de sens que rapporté à un total. Nul hors
  /// PDF, et nul quand le fichier n'a pas pu être lu.
  pageCount        Int?
  status           String            @default("draft")
  publishedAt      DateTime?
  /// Arbitrage 13 — date du **premier achat abouti**. Elle marque une ressource
  /// que le formateur n'a plus le droit d'effacer : quelqu'un l'a payée, elle
  /// doit continuer d'être servie. Ce qu'il ne peut pas effacer ne lui est plus
  /// compté (`trainerStorageUsedBytes`), et il ne le paie donc plus.
  ///
  /// Un champ plutôt qu'un `count` d'achats à la volée : la lecture du quota est
  /// sur le chemin de chaque téléversement, et l'arbitrage 19 exige de toute
  /// façon que l'appartenance ne bouge **qu'au renouvellement** — un calcul en
  /// direct ferait retomber la ressource dans le quota le jour du remboursement.
  obligationAt     DateTime?
  /// Arbitrage 12 — sortie du catalogue **subie**, pour impayé (décision 68).
  ///
  /// Sans ce marqueur, republier au règlement était impossible : la suspension
  /// écrit `status = 'archived'`, **exactement la même valeur** que celle qu'un
  /// formateur pose en archivant lui-même une ressource. Rien ne distinguait
  /// les deux, et l'audit ne gardait que le compte. Republier « ce qui a été
  /// retiré » aurait ressuscité ce qu'il avait volontairement retiré de la
  /// vente.
  catalogSuspendedAt DateTime?
  circuit          CourseCircuit     @default(MARKETPLACE)
  communityLinks   CommunityCourse[]
  purchases        Purchase[]
  courseViews      CourseView[]
  favorites        Favorite[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, category])
  @@index([trainerId, status])
  @@index([publishedAt])
  // Le quota somme les tailles d'un formateur en excluant ce qui est sous
  // obligation : c'est exactement ce couple qui est filtré.
  @@index([trainerId, obligationAt])
  @@map("courses")
}

// --- Purchase ---
model Purchase {
  id                    String                 @id @default(uuid())
  learnerId             String
  learner               User                   @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  courseId              String?
  course                Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  communityId           String?
  community             Community?             @relation(fields: [communityId], references: [id], onDelete: Restrict)
  trainerId             String
  trainerProfile        TrainerProfile         @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  amountFcfa            Int
  commissionRate        Float
  trainerShareFcfa      Int
  platformShareFcfa     Int
  amountEur             Decimal?               @db.Decimal(10, 2)
  eurRate               Decimal?               @db.Decimal(10, 4)
  provider              PaymentProvider
  providerTransactionId String?                @unique
  providerStatus        PaymentStatus          @default(PENDING)
  /// Motif de l'échec, tel que le fournisseur le nomme — `INSUFFICIENT_BALANCE`,
  /// `PAYMENT_NOT_APPROVED`. Il n'allait jusqu'ici que dans le journal d'audit,
  /// si bien que l'apprenant lisait « l'opérateur a refusé » sans jamais savoir
  /// s'il devait recharger son compte ou simplement approuver la demande.
  /// Le code brut est conservé, pas une phrase : la traduction est affaire
  /// d'écran, et un code inconnu doit rester lisible pour le support.
  failureCode           String?
  acquisitionSource     String?
  refundedAt            DateTime?
  refundAmountFcfa      Int?
  providerRefundId      String?
  providerDisputeActive Boolean                @default(false)
  accessSuspended       Boolean                @default(false)
  accessSuspendedAt     DateTime?
  accessRestoredAt      DateTime?
  periodStart           DateTime?
  periodEnd             DateTime?
  /// Porte l'invitation payante de l'initiation jusqu'au webhook : c'est là, et
  /// là seulement, qu'elle sera consommée (arbitrage 78). Un tunnel abandonné
  /// laisse donc l'invitation utilisable.
  invitationId          String?
  invitation            CommunityInvitation?   @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  communitySubscription CommunitySubscription?
  invoice               Invoice?
  disputes              Dispute[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([learnerId, createdAt])
  @@index([trainerId, createdAt])
  @@index([courseId])
  @@index([communityId])
  @@index([provider, providerStatus])
  @@index([providerDisputeActive])
  @@map("purchases")
}

// --- Community ---
model Community {
  id               String                  @id @default(uuid())
  trainerId        String
  trainerProfile   TrainerProfile          @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  name             String
  slug             String                  @unique
  description      String?
  rules            String?
  coverS3Key       String?
  /// Arbitrage 54 — la bannière occupe le quota de son formateur, au même titre
  /// que la couverture d'un cours : `trainerStorageUsedBytes()` l'additionne.
  coverSizeBytes   BigInt?
  /// La photo du groupe — carrée, et distincte de la bannière : l'une est une
  /// affiche en 16:9, l'autre tient dans un rond de 42 px en tête d'une liste
  /// de conversations. Rogner la première pour en tirer la seconde ne donnait
  /// qu'une bande de pixels.
  avatarS3Key      String?
  /// Elle, contrairement au portrait d'une personne, compte dans le quota :
  /// c'est une image publiée par un formateur, comme sa bannière.
  avatarSizeBytes  BigInt?
  priceFcfa        Int
  commissionRate   Float                   @default(0.15)
  /// Arbitrage 126 — le fil collectif est désormais un **groupe** de la
  /// messagerie. L'interrupteur garde son nom en base : c'est lui qui ouvre
  /// ou ferme ce groupe.
  forumEnabled     Boolean                 @default(true)
  messagingEnabled Boolean                 @default(true)
  resourcesEnabled Boolean                 @default(true)
  eventsEnabled    Boolean                 @default(true)
  membersCount     Int                     @default(0)
  messagesPerDay   Int                     @default(0)
  status           String                  @default("active")
  /// Arbitrage 81. `status` dit si la communauté vit ; `visibility` dit si on
  /// peut la trouver. Une privée reste `active` — elle est fermée, pas close.
  visibility       CommunityVisibility     @default(PUBLIC)
  purchases        Purchase[]
  subscriptions    CommunitySubscription[]
  favorites        Favorite[]
  courseLinks      CommunityCourse[]
  posts            CommunityPost[]
  conversations    Conversation[]
  liveSessions     LiveSession[]
  replays          Replay[]
  invitations      CommunityInvitation[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([trainerId, status])
  @@index([visibility, status])
  @@map("communities")
}

// --- CommunitySubscription ---
model CommunitySubscription {
  id                     String                      @id @default(uuid())
  communityId            String
  community              Community                   @relation(fields: [communityId], references: [id], onDelete: Restrict)
  learnerId              String
  learner                User                        @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  status                 CommunitySubscriptionStatus @default(ACTIVE)
  periodStart            DateTime
  periodEnd              DateTime
  /// ⚠️ Nullable depuis l'arbitrage 77 : un provider nul **est** la définition
  /// d'une adhésion offerte. Aucun moyen de paiement n'y a jamais été attaché,
  /// il n'y a donc rien avec quoi la reconduire — c'est ce que lit
  /// `renewDueMemberships` pour la fermer au lieu d'ouvrir une échéance.
  provider               PaymentProvider?
  providerSubscriptionId String?
  purchaseId             String?                     @unique
  purchase               Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// Attribution (arbitrage 76) : par quelle invitation ce membre est arrivé.
  /// Nulle pour une adhésion venue du catalogue.
  invitationId           String?
  invitation             CommunityInvitation?        @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  bannedAt               DateTime?
  bannedReason           String?
  bannedById             String?
  canceledAt             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([status])
  @@index([learnerId, status])
  @@index([communityId, status])
  @@map("community_subscriptions")
}

// --- CommunityInvitation (arbitrages 71-86) ---
// Un droit d'entrer, matérialisé par un jeton dans une URL. Elle ne crée aucun
// compte, ne prélève rien, et ne lève aucune décision de modération.
//
// Deux attributs distincts, et c'est le cœur du modèle :
//   `kind`  — la forme : adressée (usage unique) ou lien partageable ;
//   `grant` — la nature : mois offerts ou tunnel payant.
// Les confondre rendrait toute communauté privée gratuite à vie, puisqu'elle ne
// s'entre qu'au nominatif (arbitrages 73 et 74).
//
// Le **statut n'est pas une colonne** : il se déduit de `revokedAt`,
// `acceptedAt`, `usesCount` et `expiresAt` (`invitationStatus()`). Une colonne
// mentirait le jour où l'expiration tombe, sans que rien ne l'ait écrite.
//
// Trois contraintes CHECK et deux index uniques partiels vivent en SQL brut
// dans la migration : Prisma ne sait exprimer ni les unes ni les autres.
model CommunityInvitation {
  id            String                  @id @default(uuid())
  communityId   String
  community     Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  issuerId      String
  issuer        User                    @relation("InvitationsIssued", fields: [issuerId], references: [id], onDelete: Restrict)
  issuerRole    InvitationIssuerRole
  kind          InvitationKind
  grant         InvitationGrant
  /// Normalisée en minuscules. Non nulle si et seulement si NOMINATIVE.
  /// ⚠️ Donnée personnelle d'un tiers qui n'a peut-être aucun compte
  /// (arbitrage 80) : purgée 90 jours après l'état terminal.
  email         String?
  /// 1 à 3 (arbitrage 75). Non nul si et seulement si GIFT.
  giftMonths    Int?
  /// SHA-256 du jeton — le chemin de recherche, identique pour les deux formes.
  tokenHash     String                  @unique
  /// Jeton en clair, **et seulement pour un SHARE_LINK** : un lien de parrainage
  /// est fait pour être recopié, donc pour être réaffiché. Le garder haché
  /// obligerait à en régénérer un à chaque consultation, ce qui tuerait les
  /// liens déjà partagés.
  ///
  /// Les deux jetons n'ont pas le même enjeu : un lien partageable fuité fait
  /// adhérer quelqu'un **au tarif plein**, un jeton nominatif fuité coûte des
  /// mois offerts au formateur. Le nominatif reste donc haché seul, et nul ici.
  token         String?
  /// Huit premiers caractères du jeton : de quoi reconnaître une ligne dans une
  /// liste, pas de quoi l'accepter.
  tokenPrefix   String
  maxUses       Int                     @default(1)
  usesCount     Int                     @default(0)
  expiresAt     DateTime
  acceptedAt    DateTime?
  acceptedById  String?
  revokedAt     DateTime?
  revokedById   String?
  /// Purge RGPD (arbitrage 80) : `email` est vidé, la ligne reste pour
  /// l'attribution et pour l'audit.
  anonymizedAt  DateTime?
  subscriptions CommunitySubscription[]
  purchases     Purchase[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([communityId, createdAt])
  @@index([issuerId, createdAt])
  @@index([expiresAt])
  @@map("community_invitations")
}

// --- Favorite ---
// Une ligne par mise de côté. La cible est soit une ressource, soit une
// communauté — jamais les deux, jamais aucune : une contrainte CHECK le tient en
// base (voir la migration), Prisma ne sachant pas l'exprimer.
//
// Les deux index uniques portent chacun sur une colonne nullable : en Postgres
// deux NULL ne se heurtent pas, un utilisateur peut donc avoir autant de
// favoris de communautés qu'il veut sans que `courseId` NULL ne bloque.
model Favorite {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([userId, courseId])
  @@unique([userId, communityId])
  @@index([userId, createdAt])
  @@map("favorites")
}

// --- CommunityCourse ---
// Liaison bornée dans le temps, jamais supprimée (arbitrages 45 et 48).
//
// Délier une ressource la retire des futurs membres, mais tout membre qui y
// avait accès pendant la liaison le conserve. La formule d'accès croise donc
// les périodes de liaison et les périodes d'adhésion — supprimer la ligne
// effacerait le droit acquis de quelqu'un.
model CommunityCourse {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  linkedAt    DateTime  @default(now())
  unlinkedAt  DateTime?

  @@index([communityId, unlinkedAt])
  @@index([courseId, unlinkedAt])
  @@map("community_courses")
}

// --- Espace membre : le forum, vidé ---
//
// **Ces deux tables ne reçoivent plus rien** (arbitrage 126). Le fil collectif
// d'une communauté est devenu un groupe de la messagerie, et la migration
// `bascule_historique_groupes` a versé leur contenu dans `Message` : un billet
// est devenu un message, une réponse un message posté à sa propre date, une
// annonce un message `announcement`.
//
// Elles sont conservées vides, et non supprimées, parce que les valeurs
// `COMMUNITY_POST` et `COMMUNITY_POST_REPLY` de `ReportTargetType` gardent un
// sens historique — et parce que supprimer une table pour économiser deux
// définitions inertes n'achète rien.
//
// Rien ne doit plus écrire ici. Ce qui s'écrivait devient un `Message` dans la
// conversation `GROUP` de la communauté.
enum CommunityPostKind {
  /// Devenue `Message.announcement` (arbitrage 128).
  ANNOUNCEMENT
  /// Devenue un message ordinaire du groupe.
  DISCUSSION
}

model CommunityPost {
  id           String               @id @default(uuid())
  communityId  String
  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId     String
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  kind         CommunityPostKind
  body         String
  pinned       Boolean              @default(false)
  repliesCount Int                  @default(0)
  lastReplyAt  DateTime?
  replies      CommunityPostReply[]
  /// Retrait par l'auteur ou par le formateur. Effacer la ligne casserait le
  /// fil : les réponses resteraient sans question.
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([communityId, kind, createdAt])
  @@index([communityId, pinned, lastReplyAt])
  @@map("community_posts")
}

model CommunityPostReply {
  id          String        @id @default(uuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
  @@map("community_post_replies")
}

// --- Messagerie 1 à 1 (arbitrages 33 et 39) ---
// Le fil se rattache à **l'adhésion**, jamais à l'achat : c'est pourquoi il
// porte `communityId`. Un apprenant qui a acheté une ressource à l'unité n'a
// aucun droit de conversation, et l'unicité `(communityId, learnerId)` dit le
// reste — une communauté, un formateur, donc un seul fil par membre.
//
// Le fil survit à l'adhésion (arbitrage 39) : quand elle s'arrête, l'écriture
// cesse mais l'historique reste lisible, pour que le membre le retrouve s'il
// revient. Il n'est donc jamais supprimé avec la souscription.
/// Arbitrage 126 — une conversation est **directe** ou **de groupe**. Le fil
/// collectif d'une communauté a rejoint la messagerie ; il n'a plus de raison
/// de vivre dans un modèle à part, et le mêler aux fils privés est précisément
/// ce qui permet de les lister ensemble.
enum ConversationKind {
  /// Un membre et le formateur. `learnerId` non nul (arbitrages 33, 39).
  DIRECT
  /// Tous les membres d'une communauté. `learnerId` nul : il n'y a personne en
  /// face, il y a une communauté.
  GROUP
}

model Conversation {
  id             String           @id @default(uuid())
  kind           ConversationKind @default(DIRECT)
  communityId    String
  community      Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Nul pour un groupe. Les deux index d'unicité qui le gouvernent sont
  /// **partiels** et vivent en SQL brut : un par communauté pour le groupe, un
  /// par (communauté, membre) pour le direct.
  learnerId      String?
  learner        User?            @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  trainerId      String
  trainerProfile TrainerProfile   @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  lastMessageAt  DateTime?
  messages       Message[]
  reads          ConversationRead[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([learnerId, lastMessageAt])
  @@index([trainerId, lastMessageAt])
  @@index([communityId, kind])
  @@map("conversations")
}

/// Ce que **cette personne** a fait de **cette conversation** : où elle en est
/// de sa lecture, et si elle l'a épinglée (arbitrage 130).
///
/// `Message.readAt` ne pouvait pas servir un groupe : il porte « lu par le
/// destinataire », ce qui a un sens à deux et aucun à deux cents — il n'y a pas
/// un destinataire, il y en a autant que de membres. Le compte de non-lues
/// devient donc « messages postés après mon curseur ».
///
/// Une seule table pour les deux besoins, parce que ce sont deux facettes de la
/// même chose. La ligne naît à la première lecture ou à la première épingle ;
/// son absence signifie « jamais ouvert », ce qui est une information exacte et
/// non un trou.
model ConversationRead {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  /// Épingle posée par la personne. L'épingle du formateur sur le groupe qu'il
  /// anime n'est pas ici : elle est systématique, donc déduite et non stockée.
  pinnedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([userId, pinnedAt])
  @@map("conversation_reads")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  /// Arbitrage 128 — l'annonce du formateur. Elle épingle le message en tête du
  /// groupe **et** notifie tous les membres (F12.9). Toujours faux sur une
  /// conversation directe : on n'annonce rien à une seule personne.
  announcement   Boolean      @default(false)
  /// Clé d'idempotence, tirée par le navigateur à la frappe et rejouée telle
  /// quelle si l'envoi est relancé. Un index unique partiel la garde.
  ///
  /// Sans elle, le délai client de 20 s annulait la requête pendant que le
  /// serveur, lui, committait : l'écran annonçait « votre message n'est pas
  /// parti », la personne renvoyait, et le fil portait deux fois la même
  /// phrase. C'est le doublon que l'audit du 1er septembre a constaté.
  clientKey      String?
  /// Lu par le destinataire, jamais par l'expéditeur. **Conversation directe
  /// uniquement** : un groupe se lit par `ConversationRead`, un champ unique ne
  /// pouvant pas porter la lecture de N membres.
  readAt         DateTime?
  /// Retrait par la Modération à la clôture d'un signalement. Effacer la ligne
  /// ferait disparaître la preuve de ce qui a été instruit.
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- Lives et replays (arbitrages 31 à 43, 46, 51, 55) ---
// Un live appartient à une **communauté**, jamais à une ressource (arbitrage 32) :
// c'est pourquoi `Course.livekitRoomName` a disparu avec cette migration — le
// champ désignait une salle rattachée à une ressource, ce que l'arbitrage exclut.
//
// La capacité est la communauté elle-même (arbitrage 46) : aucun plafond de
// session à modéliser, aucune jauge à régler. L'adhésion ouvre la porte.

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

model LiveSession {
  id               String            @id @default(uuid())
  communityId      String
  community        Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  trainerId        String
  trainerProfile   TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  scheduledStartAt DateTime
  /// Arbitrage 107 — l'horodatage est en UTC comme partout ; ce champ dit dans
  /// quel fuseau l'animateur a **pensé** l'heure (identifiant IANA, ex.
  /// `Africa/Douala`). Il ne sert pas à convertir — le navigateur du lecteur
  /// s'en charge — mais à dire « 18 h 00 à Douala » à un membre de la diaspora,
  /// qui verra 19 h 00 chez lui et se demanderait laquelle des deux fait foi.
  /// Nul sur les séances programmées avant ce champ.
  timeZone         String?
  durationMinutes  Int               @default(60)
  status           LiveSessionStatus @default(SCHEDULED)
  startedAt        DateTime?
  endedAt          DateTime?
  /// Salle de transport, nommée à la création et jamais devinée — c'est
  /// exactement l'erreur que `getCourseContentUrl` a coûté sur les ressources.
  roomName         String            @unique
  /// Enregistrement automatique (arbitrage 38) : identifiant d'egress LiveKit.
  /// Nul tant que le transport n'est pas configuré.
  egressId         String?
  /// Arbitrage 94 — second egress, audio seul, pour les connexions faibles.
  /// Un fichier de 2 h pèse ~60 Mo contre ~1,3 Go pour la vidéo : c'est la
  /// différence entre un replay écoutable en 3G et un replay inaccessible.
  /// Nul quand c'est Mux qui enregistre : il produit ses propres variantes.
  audioEgressId    String?
  /// Flux d'ingestion Mux, quand c'est lui qui enregistre. Nul si le repli
  /// fichier vers le stockage objet a été retenu.
  muxStreamId      String?
  peakParticipants Int               @default(0)
  participants     LiveParticipant[]
  messages         LiveMessage[]
  replay           Replay?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([communityId, scheduledStartAt])
  @@index([status, scheduledStartAt])
  /// Créé par la migration `20260804120000_mux_replays` mais jamais déclaré
  /// ici : le webhook Mux retrouve la session par ce champ. Sans cette ligne,
  /// la prochaine migration générée le supprimait sans que personne ne
  /// l'ait demandé.
  @@index([muxStreamId])
  @@map("live_sessions")
}

model LiveParticipant {
  id           String      @id @default(uuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt     DateTime    @default(now())
  leftAt       DateTime?
  /// Verrou posé par l'animateur (arbitrage 35). Ce n'est **pas** l'état du
  /// micro : le lever ne rallume rien, cela rend au participant la commande de
  /// son propre micro (arbitrage 41). Se traduit par `canPublish` côté LiveKit.
  mutedByHost  Boolean     @default(false)
  /// Arbitrage 93 — la place sur la scène, plafonnée à neuf publieurs.
  ///
  /// **Distincte de `mutedByHost`, et il ne faut pas les confondre** : l'un est
  /// un verrou posé sur quelqu'un, l'autre une place disponible ou prise. Un
  /// participant sans place n'a été puni de rien — la scène est pleine, il lève
  /// la main comme les autres (arbitrage 36). Les fondre en un seul booléen
  /// ferait lire « l'animateur vous a coupé le micro » à quelqu'un que personne
  /// n'a coupé.
  onStage      Boolean     @default(false)
  /// Horodatage et non booléen : c'est lui qui ordonne et numérote la file des
  /// demandes de parole (arbitrage 36).
  handRaisedAt DateTime?

  @@unique([sessionId, userId])
  @@index([sessionId, handRaisedAt])
  /// Compter les places prises est le geste le plus fréquent de la séance : il
  /// se refait à chaque entrée en salle et à chaque prise de parole accordée.
  @@index([sessionId, onStage])
  @@map("live_participants")
}

/// Salon du live. Conservé après la séance et rattaché au replay (arbitrage 42) :
/// ce n'est pas un canal éphémère.
model LiveMessage {
  id          String      @id @default(uuid())
  sessionId   String
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  /// Retrait par la Modération. Le salon reste attaché au replay (arbitrage
  /// 42) : sans retrait, un propos instruit resterait lisible indéfiniment.
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("live_messages")
}

enum ReplayStatus {
  PROCESSING
  READY
  FAILED
  PURGED
}

model Replay {
  id              String         @id @default(uuid())
  sessionId       String         @unique
  session         LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  communityId     String
  community       Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  trainerId       String
  trainerProfile  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  title           String
  /// Arbitrage 34 — **c'est la date du live qui fait foi**, pas celle de la mise
  /// en ligne de l'enregistrement. C'est elle que croise l'accès résiduel.
  recordedAt      DateTime
  durationSeconds Int?
  s3Key           String?
  /// Identifiants Mux. Quand ils sont renseignés, l'enregistrement est hébergé
  /// chez Mux : il ne consomme donc **pas** le quota du formateur, et
  /// `sizeBytes` reste nul à dessein (arbitrage 54).
  muxAssetId      String?
  muxPlaybackId   String?
  /// `BIGINT` : un enregistrement d'une heure dépasse la capacité d'un entier
  /// 32 bits, comme les vidéos de ressources. Ne compte dans le quota que pour
  /// les replays réellement stockés chez nous.
  sizeBytes       BigInt?
  /// Arbitrage 94 — la variante audio seule, quand l'enregistrement est chez
  /// nous. Elle compte dans le quota comme la vidéo : ce sont nos octets.
  audioS3Key      String?
  audioSizeBytes  BigInt?
  status          ReplayStatus   @default(PROCESSING)
  /// Arbitrage 51 — purge à 24 mois. La date est portée, pas recalculée : une
  /// règle qui change ne doit pas effacer rétroactivement ce qui était promis.
  purgeAt         DateTime
  purgedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([communityId, recordedAt])
  @@index([status, purgeAt])
  @@map("replays")
}

// --- Wallet ---
model Wallet {
  id                   String                 @id @default(uuid())
  trainerId            String                 @unique
  trainerProfile       TrainerProfile         @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  balance              Int                    @default(0)
  reservedBalance      Int                    @default(0)
  pendingPayoutBalance Int                    @default(0)
  negativeSince        DateTime?
  fundReservations     FundReservation[]
  reconciliations      WalletReconciliation[]
  debits               WalletDebit[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("wallets")
}

/// Ce qui fait baisser un solde autrement qu'un retrait ou un remboursement.
enum WalletDebitReason {
  /// Prélèvement de l'échéance d'abonnement, sur consentement (arbitrage 8).
  SUBSCRIPTION_RENEWAL
  /// Dette d'une période consommée, récupérée à la résiliation (arbitrage 10).
  /// **Ne dépend pas du consentement** au prélèvement automatique : la période
  /// a été servie, elle se paie.
  SUBSCRIPTION_ARREARS
}

// --- WalletDebit ---
/// Le portefeuille n'avait **aucun grand-livre** : `balance` est une valeur
/// mutable, et seule `WalletReconciliation` gardait trace des corrections
/// manuelles. Un solde qui baisse sans ligne pour l'expliquer est un défaut —
/// le formateur voit son argent partir et n'a rien à lire.
///
/// Ce modèle ne couvre pas tous les mouvements : un retrait se lit sur `Payout`,
/// un débit de litige sur `FundReservation`. Il couvre ce qui n'avait pas de
/// pièce à soi, c'est-à-dire les prélèvements d'abonnement.
model WalletDebit {
  id                   String              @id @default(uuid())
  walletId             String
  wallet               Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  trainerId            String
  amountFcfa           Int
  reason               WalletDebitReason
  /// La période réglée par ce prélèvement. **L'unicité est l'idempotence** : une
  /// même échéance ne peut pas être prélevée deux fois, et c'est la base qui le
  /// refuse — pas la prudence du code. Le rejeu nocturne de l'arbitrage 9 en
  /// dépend : il repasse chaque nuit sur les mêmes périodes.
  subscriptionChargeId String?             @unique
  subscriptionCharge   SubscriptionCharge? @relation(fields: [subscriptionChargeId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  @@index([trainerId, createdAt])
  @@map("wallet_debits")
}

// --- WalletReconciliation ---
model WalletReconciliation {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  field          String
  previousValue  Int
  newValue       Int
  delta          Int
  reason         String
  reconciledById String
  createdAt      DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_reconciliations")
}

// --- PayoutMethod ---
model PayoutMethod {
  id                          String                         @id @default(uuid())
  trainerId                   String
  trainerProfile              TrainerProfile                 @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  type                        PayoutMethodType
  accountNature               AccountNature
  verifiedLegalNameAtCreation String
  trainerEmailSnapshot        String
  trainerPhoneSnapshot        String?
  holderName                  String?
  businessName                String?
  businessDocS3Key            String?
  legalRepProofS3Key          String?
  iban                        String?
  bic                         String?
  mobileOperator              MobileMoneyOperator?
  mobilePhone                 String?
  verificationStatus          PayoutMethodVerificationStatus @default(PENDING_REVIEW)
  verificationMethod          VerificationMethod?
  nameLookupResult            String?
  nameLookupRawName           String?
  microDepositAmount1         Int?
  microDepositAmount2         Int?
  microDepositReference       String?
  microDepositVerifiedAt      DateTime?
  carenceUntil                DateTime?
  isActive                    Boolean                        @default(true)
  archivedAt                  DateTime?
  reviewedById                String?
  reviewedAt                  DateTime?
  rejectionReason             String?
  payouts                     Payout[]
  reviewEvents                PayoutMethodReviewEvent[]
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt

  @@index([trainerId, isActive])
  @@index([verificationStatus])
  @@index([carenceUntil])
  @@map("payout_methods")
}

// --- Payout ---
model Payout {
  id                  String              @id @default(uuid())
  trainerId           String
  trainerProfile      TrainerProfile      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  payoutMethodId      String
  payoutMethod        PayoutMethod        @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  amountFcfa          Int
  /// Frais du fournisseur retenus **sur le montant** — arbitrage 6. Nuls sur un
  /// retrait ordinaire : la plateforme les absorbe. Renseignés sur le versement
  /// dérogatoire de fin de vie, où le reliquat peut être inférieur au coût du
  /// transfert et où les faire porter à la plateforme reviendrait à payer pour
  /// rendre l'argent.
  feeFcfa             Int                 @default(0)
  /// Versement de clôture, dispensé du minimum de 10 000 FCFA (arbitrage 6).
  ///
  /// Sans cette dérogation, un formateur qui part avec 3 200 FCFA ne peut
  /// jamais les retirer — donc son espace ne se ferme jamais, et la règle de
  /// l'arbitrage 5 (« jusqu'à solde retiré ») boucle indéfiniment.
  isClosingPayout     Boolean             @default(false)
  status              PayoutStatus        @default(PENDING)
  kycScoreSnapshot    Int?
  kycBadgeSnapshot    String?
  kycCriteriaSnapshot Json?
  isFirstPayout       Boolean             @default(false)
  carenceHolds        Boolean             @default(false)
  wireInitiatedAt     DateTime?
  idempotencyKey      String?
  submittedAt         DateTime            @default(now())
  reviewedById        String?
  reviewedAt          DateTime?
  approvedById        String?
  approvedAt          DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?
  paidAt              DateTime?
  providerReference   String?
  failedAt            DateTime?
  failureReason       String?
  receiptS3Key        String?
  reviewEvents        PayoutReviewEvent[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([trainerId, status])
  @@index([status, submittedAt])
  @@map("payouts")
}

// --- PayoutMethodReviewEvent ---
model PayoutMethodReviewEvent {
  id             String                         @id @default(uuid())
  payoutMethodId String
  payoutMethod   PayoutMethod                   @relation(fields: [payoutMethodId], references: [id], onDelete: Cascade)
  fromStatus     PayoutMethodVerificationStatus
  toStatus       PayoutMethodVerificationStatus
  actorId        String?
  actorRole      String?
  note           String?
  createdAt      DateTime                       @default(now())

  @@index([payoutMethodId, createdAt])
  @@map("payout_method_review_events")
}

// --- PayoutReviewEvent ---
model PayoutReviewEvent {
  id         String       @id @default(uuid())
  payoutId   String
  payout     Payout       @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  fromStatus PayoutStatus
  toStatus   PayoutStatus
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([payoutId, createdAt])
  @@map("payout_review_events")
}

/// Code de secours à usage unique, pour qui perd son téléphone.
///
/// Haché en SHA-256 et non en Argon2, à dessein : un code de secours est tiré
/// au hasard sur 80 bits, il n'a pas la faible entropie d'un mot de passe qu'un
/// hachage lent doit compenser. Argon2 sur dix codes à chaque tentative
/// coûterait une seconde de calcul pour aucun gain.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

// --- Facture ---
// Une facture est **immuable** : ni son numéro, ni son montant, ni sa date ne
// changent après émission. Ce qui doit être corrigé l'est par un avoir, pas par
// une réécriture — d'où l'absence de tout champ modifiable ici.
enum InvoiceKind {
  /// Achat d'une ressource ou adhésion à une communauté.
  PURCHASE
  /// Période d'abonnement du formateur, stockage compris (arbitrage 69).
  SUBSCRIPTION
}

model Invoice {
  id                   String              @id @default(uuid())
  /// Numéro affiché, figé à l'émission. Sa suite est **sans trou** : voir
  /// `InvoiceCounter`, qui l'attribue.
  number               String              @unique
  kind                 InvoiceKind
  /// Destinataire — l'acheteur, ou le formateur pour un abonnement.
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  purchaseId           String?             @unique
  purchase             Purchase?           @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  subscriptionChargeId String?             @unique
  subscriptionCharge   SubscriptionCharge? @relation(fields: [subscriptionChargeId], references: [id], onDelete: Restrict)
  /// Libellé et montants figés au moment de l'émission : le tarif change, la
  /// facture émise ne change pas avec lui (décision 57).
  label                String
  amountFcfa           Int
  issuedAt             DateTime            @default(now())
  createdAt            DateTime            @default(now())

  @@index([userId, issuedAt])
  @@map("invoices")
}

/// Compteur de numérotation, une ligne par exercice.
///
/// Une séquence Postgres serait plus simple mais laisserait des trous : elle
/// avance même quand la transaction échoue. Une numérotation de facture doit
/// être continue — d'où une ligne verrouillée par l'`UPDATE`, qui n'avance que
/// si la transaction aboutit.
model InvoiceCounter {
  year  Int @id
  value Int @default(0)

  @@map("invoice_counters")
}

// --- AuditLog ---
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// --- Notification ---
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// --- FxRate ---
/// Taux de change du FCFA vers une devise d'encaissement.
///
/// Table à part, et non une clé de `Setting` : le registre des réglages est
/// fermé, borné et entier, avec une valeur de repli assumée. Un taux de change
/// est décimal, il ne doit avoir **aucun** repli — une devise sans taux refuse
/// le paiement plutôt que d'en inventer un — et une erreur de saisie mésestime
/// toutes les ventes du pays concerné. Il mérite donc sa trace propre :
/// qui l'a posé, et quand.
model FxRate {
  id          String   @id @default(uuid())
  /// ISO 4217 : TZS, KES, GHS, MWK, CDF, RWF, UGX, ZMW, MZN, SLE, USD.
  /// XAF et XOF n'y figurent jamais : ils sont à parité fixe avec le FCFA.
  currency    String   @unique
  /// Unités de `currency` pour **un** FCFA.
  unitsPerXaf Decimal  @db.Decimal(18, 8)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fx_rates")
}

// --- Setting ---
model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// --- EmailOtp ---
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@map("email_otps")
}

// --- PendingAttachment ---
model PendingAttachment {
  id         String    @id @default(uuid())
  s3Key      String    @unique
  issuerId   String
  scope      String
  disputeId  String?
  status     String    @default("PENDING")
  mimeType   String
  sizeBytes  Int
  sha256     String
  consumedAt DateTime?
  consumedIn String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime

  @@index([issuerId, status])
  @@index([expiresAt])
  @@index([scope, status])
  @@map("pending_attachments")
}

// --- TrainerApplication ---
model TrainerApplication {
  id                   String                          @id @default(uuid())
  userId               String
  user                 User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status               TrainerApplicationStatus        @default(DRAFT)
  slogan               String?
  description          String?
  websiteUrl           String?
  domains              String[]
  experienceYears      Int?
  /**
   * Cadence d'abonnement demandée par le candidat, quand le parcours la lui a
   * fait choisir. Elle n'engage rien : elle n'est honorée qu'à l'approbation,
   * où elle devient `TrainerProfile.subscriptionCadence`. Nulle si le dossier
   * a été ouvert par un parcours qui ne pose pas la question.
   */
  desiredCadence       PlanCadence?
  /**
   * Identité retenue par la modération à l'approbation. Elle est conservée ici
   * parce que le `TrainerProfile` qui la portera ne naît plus dans la même
   * transaction : il attend le règlement du premier abonnement.
   */
  verifiedLegalName    String?
  submittedAt          DateTime?
  reviewedById         String?
  reviewedAt           DateTime?
  finalRejectionReason String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  reopenedById         String?
  reopenedAt           DateTime?
  documents            TrainerDocument[]
  reviewEvents         TrainerApplicationReviewEvent[]
  activationPayments   TrainerActivationPayment[]
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([status])
  @@index([submittedAt])
  @@map("trainer_applications")
}

// --- TrainerDocument ---
model TrainerDocument {
  id                String                       @id @default(uuid())
  applicationId     String
  application       TrainerApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type              TrainerDocumentType
  status            TrainerDocumentStatus        @default(AWAITING_UPLOAD)
  isCurrent         Boolean                      @default(true)
  s3Key             String
  sha256            String
  sizeBytes         Int
  mimeType          String?
  originalFileName  String?
  rejectionReason   String?
  resubmissionCount Int                          @default(0)
  reviewedById      String?
  reviewedAt        DateTime?
  purgedAt          DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  reviews           TrainerDocumentReviewEvent[]

  @@index([applicationId, type, isCurrent])
  @@index([status])
  @@index([applicationId, status])
  @@map("trainer_documents")
}

// --- TrainerActivationPayment ---
/// Le règlement du premier abonnement, exigé **avant** que le formateur existe.
///
/// Il ne peut pas prendre la forme d'un `SubscriptionCharge` : celui-ci porte un
/// `trainerId`, donc un `TrainerProfile` — et tout l'objet de cette étape est
/// que le profil ne naisse qu'une fois l'argent encaissé. La ligne est donc
/// rattachée à la candidature, et c'est son règlement qui déclenche
/// l'ouverture de l'espace.
///
/// Les montants sont **figés à l'ouverture du paiement** (décision 57) : la
/// grille peut bouger entre le clic et le retour du fournisseur, ce qui est
/// encaissé est ce qui a été annoncé.
model TrainerActivationPayment {
  id                    String             @id @default(uuid())
  applicationId         String
  application           TrainerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  cadence               PlanCadence
  listPriceFcfa         Int
  discountFcfa          Int                @default(0)
  discountLabel         String?
  amountFcfa            Int
  provider              PaymentProvider
  /// Nul le temps que le fournisseur rende son identifiant.
  providerTransactionId String?            @unique
  providerStatus        PaymentStatus      @default(PENDING)
  /// Motif d'échec tel que le fournisseur le nomme, comme sur `Purchase` :
  /// le candidat doit savoir s'il recharge son compte ou s'il réessaie.
  failureCode           String?
  paidAt                DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Une seule tentative en cours ou réussie par dossier : c'est le service qui
  // le tient, l'index est là pour que la lecture soit directe.
  @@index([applicationId, providerStatus])
  @@map("trainer_activation_payments")
}

// --- TrainerApplicationReviewEvent ---
model TrainerApplicationReviewEvent {
  id             String                   @id @default(uuid())
  applicationId  String
  application    TrainerApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus     TrainerApplicationStatus
  toStatus       TrainerApplicationStatus
  actorId        String?
  reason         String?
  rejectedDocIds String[]
  createdAt      DateTime                 @default(now())

  @@index([applicationId, createdAt])
  @@map("trainer_application_review_events")
}

// --- TrainerDocumentReviewEvent ---
model TrainerDocumentReviewEvent {
  id              String                @id @default(uuid())
  documentId      String
  document        TrainerDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fromStatus      TrainerDocumentStatus
  toStatus        TrainerDocumentStatus
  actorId         String?
  rejectionReason String?
  createdAt       DateTime              @default(now())

  @@index([documentId, createdAt])
  @@map("trainer_document_review_events")
}

// --- Dispute ---
model Dispute {
  id                    String               @id @default(uuid())
  purchaseId            String
  purchase              Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  learnerId             String
  learner               User                 @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  trainerId             String
  trainerProfile        TrainerProfile       @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  source                DisputeSource
  reason                DisputeReason
  reasonDetail          String?
  status                DisputeStatus        @default(OPEN)
  disputedAmountFcfa    Int
  amountEur             Decimal?             @db.Decimal(10, 2)
  resolution            DisputeResolution?
  resolutionNote        String?
  overrideJustification String?
  resolvedById          String?
  resolvedAt            DateTime?
  openedAt              DateTime             @default(now())
  lastActivityAt        DateTime             @default(now())
  learnerDeadlineAt     DateTime?
  providerDisputeId     String?
  consumptionSnapshotId String?
  refundStatus          String?
  refundProcessedAt     DateTime?
  providerRefundId      String?
  fundReservations      FundReservation[]
  messages              DisputeMessage[]
  reviewEvents          DisputeReviewEvent[]
  supportTickets        SupportTicket[]
  consumptionSnapshot   ConsumptionSnapshot?
  manualRefundTask      ManualRefundTask?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@index([purchaseId])
  @@index([trainerId, status])
  @@index([learnerId, status])
  @@index([lastActivityAt])
  @@map("disputes")
}

// --- DisputeMessage ---
model DisputeMessage {
  id            String                   @id @default(uuid())
  disputeId     String
  dispute       Dispute                  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId      String?
  authorRole    DisputeMessageAuthorRole
  body          String
  attachments   String[]
  readBySupport Boolean                  @default(false)
  readByLearner Boolean                  @default(false)
  createdAt     DateTime                 @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

// --- FundReservation ---
model FundReservation {
  id                 String                @id @default(uuid())
  disputeId          String
  dispute            Dispute               @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  walletId           String
  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reservedAmountFcfa Int
  status             FundReservationStatus @default(ACTIVE)
  debitedAmount      Int                   @default(0)
  releasedAmount     Int                   @default(0)
  createdAt          DateTime              @default(now())
  releasedAt         DateTime?
  releasedById       String?
  releaseReason      String?

  @@index([disputeId])
  @@index([walletId, status])
  @@map("fund_reservations")
}

// --- DisputeReviewEvent ---
model DisputeReviewEvent {
  id         String        @id @default(uuid())
  disputeId  String
  dispute    Dispute       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fromStatus DisputeStatus
  toStatus   DisputeStatus
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([disputeId, createdAt])
  @@map("dispute_review_events")
}

// --- ConsumptionSnapshot ---
model ConsumptionSnapshot {
  id                    String   @id @default(uuid())
  disputeId             String   @unique
  dispute               Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  courseId              String
  courseFormat          String
  watchedSeconds        Int?
  courseDurationSeconds Int?
  /// Document — la page atteinte et le total, figés comme le reste (F3.1).
  ///
  /// Un format téléchargeable échappe à la règle des 30 % et part en décision
  /// **manuelle** (F8.1) : l'agent doit donc voir ce qui a été lu. Avant le
  /// lot 7 il ne voyait que « non téléchargée, 0 % » d'un PDF lu en entier en
  /// ligne, ce qui ne lui disait rien. Ces deux colonnes ne changent aucune
  /// éligibilité : elles renseignent.
  lastPage              Int?
  coursePageCount       Int?
  downloaded            Boolean?
  consumptionPercent    Int
  ruleApplies           Boolean
  snapshotAt            DateTime @default(now())

  @@map("consumption_snapshots")
}

// --- CourseView ---
model CourseView {
  id             String    @id @default(uuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  learnerId      String
  learner        User      @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  /// Vidéo — le point **le plus loin** atteint, jamais le dernier vu. Ce
  /// nombre arbitre automatiquement un remboursement (F8.1, seuil de 30 %) :
  /// un recul ne doit pas rouvrir un droit que la lecture a consommé.
  watchedSeconds Int       @default(0)
  /// Document — la page où l'on s'est arrêté, **dernière valeur écrite** et non
  /// la plus lointaine. L'asymétrie avec `watchedSeconds` est délibérée : ce
  /// nombre-ci n'arbitre rien tout seul (un format téléchargeable échappe à la
  /// règle des 30 %, F8.1), il sert à **reprendre la lecture** et à renseigner
  /// l'agent qui instruit un litige. Reprendre à la page la plus lointaine
  /// plutôt qu'à la dernière ferait perdre sa page à qui revient en arrière.
  lastPage       Int?
  downloaded     Boolean   @default(false)
  downloadedAt   DateTime?
  /// Archives (kit, modèle, tableur) — le marqueur « terminé » que l'apprenant
  /// pose lui-même (F3.3). Rien ne peut le mesurer à sa place : une archive ne
  /// se rend pas en ligne.
  ///
  /// **Sans effet sur les litiges.** Le seuil de consommation d'un format
  /// téléchargeable reste `downloaded` et lui seul (F8.1) : déclarer une
  /// lecture terminée ne doit pas fermer un droit au remboursement, et ne pas
  /// la déclarer ne doit pas en ouvrir un.
  completedAt    DateTime?
  lastViewedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([courseId, learnerId])
  @@index([learnerId, courseId])
  @@map("course_views")
}

// --- ManualRefundTask ---
model ManualRefundTask {
  id               String    @id @default(uuid())
  disputeId        String    @unique
  dispute          Dispute   @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  provider         String    @default("PAWAPAY")
  refundAmountFcfa Int
  trainerDebitFcfa Int
  status           String    @default("PENDING")
  errorMessage     String?
  assignedToId     String?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("manual_refund_tasks")
}

// --- SupportTicket ---
model SupportTicket {
  id             String    @id @default(uuid())
  disputeId      String
  dispute        Dispute   @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  trainerId      String
  trainer        User      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  reason         String
  attachments    String[]
  status         String    @default("OPEN")
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([disputeId])
  @@index([trainerId, status])
  @@map("support_tickets")
}

// ==========================================================================
// Signalements (décision 7 — périmètre Modération)
// ==========================================================================
// Un seul modèle générique plutôt qu'un signalement par surface : la
// Modération doit pouvoir répondre à « montre-moi tout ce qui est signalé »,
// ce qu'une table par surface interdit.
//
// `targetId` n'est volontairement **pas** une clé étrangère : les cibles
// vivent dans des tables différentes, et certaines n'existent pas encore
// (MESSAGE attend la messagerie). La résolution du libellé se fait à la
// lecture, et une cible introuvable s'affiche comme telle.

enum ReportTargetType {
  COURSE
  USER
  COMMUNITY
  /// Billet du fil d'une communauté (annonce ou discussion).
  COMMUNITY_POST
  /// Réponse sous un billet. Distincte du billet : elle se retire seule.
  COMMUNITY_POST_REPLY
  /// Message de la messagerie 1 à 1.
  MESSAGE
  /// Message du salon d'une séance live. Il survit à la séance (arbitrage 42).
  LIVE_MESSAGE
  DISPUTE_MESSAGE
}

enum ReportReason {
  ILLEGAL
  MISLEADING
  HARASSMENT
  SPAM
  INTELLECTUAL_PROPERTY
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  detail       String?
  status       ReportStatus     @default(OPEN)
  /**
   * Renseigné à la clôture : ce que la Modération a fait, en clair.
   */
  decisionNote String?
  /**
   * La ressource a-t-elle été retirée du catalogue à la clôture ?
   */
  targetHidden Boolean          @default(false)
  reviewedById String?
  reviewedBy   User?            @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// ==========================================================================
// Tarification de l'abonnement plateforme (décisions 56, 57, 59, 61, 62)
// ==========================================================================
// Le tarif vit en base et il est daté : la gratuité de lancement n'est pas un
// cas particulier codé en dur, c'est un tarif à 0 avec une date de fin.

enum TariffKind {
  /// Abonnement du formateur à la plateforme (décisions 49, 59).
  SUBSCRIPTION
  /// Palier de 50 Go de stockage au-delà des 40 Go inclus (arbitrages 54, 69).
  STORAGE_TIER
}

model PlatformTariff {
  id          String      @id @default(uuid())
  /// Ce que ce tarif facture. Sans lui, une requête de tarif d'abonnement
  /// pourrait rendre le prix d'un palier de stockage — les deux vivent dans la
  /// même table parce qu'ils suivent la même règle : administrés, datés,
  /// jamais réécrits (décision 59).
  kind        TariffKind  @default(SUBSCRIPTION)
  cadence     PlanCadence
  amountFcfa  Int
  /**
   * Fenêtre de validité. `validUntil` nul = tarif courant.
   */
  validFrom   DateTime    @default(now())
  validUntil  DateTime?
  label       String?
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([kind, cadence, validFrom])
  @@map("platform_tariffs")
}

enum DiscountKind {
  CAMPAIGN
  TRAINER
  PROMO_CODE
}

// Décision 62 — trois canaux, un seul résultat : le montant consenti. Décision
// de cumul : **la plus favorable l'emporte**, elles ne s'additionnent jamais.
model PlatformDiscount {
  id          String       @id @default(uuid())
  kind        DiscountKind
  label       String
  /**
   * Montant retiré, en FCFA. Le pourcentage n'est qu'un affichage (décision 57).
   */
  amountFcfa  Int
  /**
   * PROMO_CODE uniquement — saisi par le formateur à la souscription.
   */
  code        String?      @unique
  /**
   * TRAINER uniquement — remise négociée, toujours motivée.
   */
  trainerId   String?
  reason      String?
  validFrom   DateTime     @default(now())
  validUntil  DateTime?
  maxUses     Int?
  usedCount   Int          @default(0)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kind, validFrom])
  @@index([trainerId])
  @@map("platform_discounts")
}

// ==========================================================================
// Cycle de vie de l'abonnement formateur (décisions 52, 56, 61, 68, 70)
// ==========================================================================
// Une ligne par période facturée. Le montant y est figé (décision 57) : le
// tarif change, une période déjà ouverte ne change pas avec lui.

enum SubscriptionChargeStatus {
  DUE
  SETTLED
  WAIVED
}

// --- SubscriptionPayment ---
/// Un règlement d'abonnement par carte ou mobile money — arbitrage 11.
///
/// Pendant de `TrainerActivationPayment`, pour les **renouvellements** : le
/// premier abonnement se règle avant que le profil existe, les suivants une
/// fois qu'il existe. Deux modèles plutôt qu'un, parce qu'ils ne s'accrochent
/// pas au même objet — l'un à une candidature, l'autre à un formateur.
model SubscriptionPayment {
  id                    String         @id @default(uuid())
  trainerId             String
  trainerProfile        TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  amountFcfa            Int
  /// Les périodes que ce règlement couvre, **figées à l'ouverture**.
  ///
  /// Sans cette liste, un renouvellement survenu entre l'ouverture du paiement
  /// et le retour du fournisseur verrait sa période soldée par un montant qui
  /// ne la couvrait pas : le formateur aurait payé deux périodes et en aurait
  /// réglé trois.
  chargeIds             String[]
  provider              PaymentProvider
  /// Nul le temps que le fournisseur rende son identifiant.
  providerTransactionId String?        @unique
  providerStatus        PaymentStatus  @default(PENDING)
  /// Motif d'échec tel que le fournisseur le nomme, comme sur `Purchase`.
  failureCode           String?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Une seule tentative en vol par formateur : c'est le service qui le tient,
  // l'index est là pour que la lecture soit directe.
  @@index([trainerId, providerStatus])
  @@map("subscription_payments")
}

model SubscriptionCharge {
  id             String                   @id @default(uuid())
  trainerId      String
  trainerProfile TrainerProfile           @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  cadence        PlanCadence
  periodStart    DateTime
  periodEnd      DateTime
  listPriceFcfa  Int
  discountFcfa   Int                      @default(0)
  discountLabel  String?
  /// Paliers de stockage facturés sur cette période, et leur montant. Figés
  /// comme le reste : réduire ses paliers ne réécrit pas une période ouverte.
  storageTiers   Int                      @default(0)
  storageFcfa    Int                      @default(0)
  amountDueFcfa  Int
  /// Vrai quand cette période a **reconduit** le prix de la précédente parce
  /// que la grille avait changé entre-temps : un formateur déjà abonné encaisse
  /// une modification tarifaire à son 2e renouvellement, pas au 1er. Le drapeau
  /// est ce qui distingue « report en cours » de « report déjà consommé » —
  /// sans lui, la comparaison avec la grille reporterait indéfiniment.
  tariffDeferred Boolean                  @default(false)
  status         SubscriptionChargeStatus @default(DUE)
  settledAt      DateTime?
  invoice        Invoice?
  /// Le prélèvement sur solde qui a réglé cette période, s'il y en a eu un.
  walletDebit    WalletDebit?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Idempotence du job de renouvellement : rejouer un tour ne peut pas
  // facturer deux fois la même période.
  @@unique([trainerId, periodStart])
  @@index([status, periodEnd])
  @@map("subscription_charges")
}
