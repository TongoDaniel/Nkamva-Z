// Périmètre typé par `next build`. L'image Docker n'embarque ni `tests/` ni
// `docs/` (.dockerignore) : ce qui en dépend — l'outil `check:orphans` — n'a
// rien à faire dans le build. L'application mobile (`mobile/`) a son propre
// projet TypeScript et ne passe jamais par `next build`. Le job « typecheck » de la CI vérifie, lui,
// tout `tsconfig.json`.
{
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "mobile", "tests", "scripts/orphans.ts"]
}
