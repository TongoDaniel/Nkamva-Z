# Copier en `.env` et renseigner. Le vrai `.env` n'est pas suivi par git.

# ── Base de données ─────────────────────────────────────────────────────────────
# Le dépôt ne fournit plus de docker-compose. Serveur de dev équivalent :
#
#   docker run -d --name nkamva-db-5433 -p 5433:5432 \
#     -e POSTGRES_USER=nkamva -e POSTGRES_DB=nkamva \
#     -e POSTGRES_HOST_AUTH_METHOD=trust \
#     -v nkamva-pgdata:/var/lib/postgresql/data postgres:16-alpine
#   docker exec nkamva-db-5433 createdb -U nkamva nkamva_test
#
# Puis appliquer les migrations sur chacune des deux bases :
#   bunx prisma migrate deploy
#   DATABASE_URL="postgresql://nkamva@localhost:5433/nkamva_test?schema=public" bunx prisma migrate deploy
#
# `trust` : aucun mot de passe, serveur de développement local uniquement.
DATABASE_URL=postgresql://nkamva@localhost:5433/nkamva?schema=public
# Base séparée pour `bun run test` (les tests la vident par TRUNCATE)
TEST_DATABASE_URL=postgresql://nkamva@localhost:5433/nkamva_test?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────────
# Doit être identique à AUTH_SECRET côté edulink-api (cookie de session JWE)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────────
# Vide = mode dev, les envois sont seulement journalisés en console
RESEND_API_KEY=
EMAIL_FROM=NkamVa <noreply@nkamva.com>

# ── Stockage objet (Cloudflare R2) ──────────────────────────────────────────────
# Vide = URLs présignées factices
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=nkamva-dev
R2_PUBLIC_URL=

# ── Stripe ──────────────────────────────────────────────────────────────────────
# Vide = les refunds Lot 2 sont réputés acceptés en dev (pas d'appel provider)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CinetPay ────────────────────────────────────────────────────────────────────
# Vide = aucun appel émis ; les remboursements partent en ManualRefundTask
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète marchande, distincte de l'apikey : sert à vérifier le HMAC
# X-TOKEN des notifications. Non renseignée, la vérification est ignorée.
CINETPAY_SECRET_KEY=
# Endpoint de remboursement à valider contre l'API réelle (cf. décision 15)
CINETPAY_REFUND_URL=

# ── URLs ────────────────────────────────────────────────────────────────────────
# Base des liens dans les emails (un href relatif est mort en client mail)
WEB_BASE_URL=http://localhost:3000

# ── Jobs planifiés ──────────────────────────────────────────────────────────────
# Mettre à 1 pour ne pas démarrer node-cron (utile en CI)
DISABLE_SCHEDULED_JOBS=
