# Copier en `.env` et renseigner. Le vrai `.env` n'est pas suivi par git.

# ── Base de données ─────────────────────────────────────────────────────────────
# Le dépôt ne fournit plus de docker-compose. Serveur de dev équivalent :
#
#   docker run -d --name nkamva-db-5433 -p 5433:5432 \
#     -e POSTGRES_USER=nkamva -e POSTGRES_DB=nkamva \
#     -e POSTGRES_HOST_AUTH_METHOD=trust \
#     -v nkamva-pgdata:/var/lib/postgresql/data postgres:16-alpine
#   docker exec nkamva-db-5433 createdb -U nkamva nkamva_test
#
# Puis appliquer les migrations sur chacune des deux bases :
#   bunx prisma migrate deploy
#   DATABASE_URL="postgresql://nkamva@localhost:5433/nkamva_test?schema=public" bunx prisma migrate deploy
#
# `trust` : aucun mot de passe, serveur de développement local uniquement.
DATABASE_URL=postgresql://nkamva@localhost:5433/nkamva?schema=public
# Base séparée pour `bun run test` (les tests la vident par TRUNCATE)
TEST_DATABASE_URL=postgresql://nkamva@localhost:5433/nkamva_test?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────────
# Doit être identique à AUTH_SECRET côté edulink-api (cookie de session JWE)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────────
# Vide = mode dev, les envois sont seulement journalisés en console
RESEND_API_KEY=
EMAIL_FROM=NkamVa <noreply@nkamva.com>

# ── Stockage objet (S3 et compatibles : R2, Backblaze, MinIO…) ─────────────────
# Vide = URLs présignées factices, et AUCUN fichier réellement stocké.
# Noms standard du SDK AWS, à dessein : ce sont ceux que la chaîne de
# credentials par défaut reconnaît. Le code a longtemps lu `R2_*` alors que
# l'environnement fournissait ceux-ci — rien ne correspondait, et le repli
# silencieux faisait passer l'absence de stockage pour un fonctionnement normal.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# `auto` convient aux compatibles S3 sans régions, R2 en tête.
AWS_REGION=auto
AWS_BUCKET_NAME=nkamva-dev
AWS_PUBLIC_URL=

# ── Stripe ──────────────────────────────────────────────────────────────────────
# Vide = les refunds Lot 2 sont réputés acceptés en dev (pas d'appel provider)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CinetPay ────────────────────────────────────────────────────────────────────
# Vide = aucun appel émis ; les remboursements partent en ManualRefundTask
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Clé secrète marchande, distincte de l'apikey : sert à vérifier le HMAC
# X-TOKEN des notifications. Non renseignée, la vérification est ignorée.
CINETPAY_SECRET_KEY=
# Endpoint de remboursement à valider contre l'API réelle (cf. décision 15)
CINETPAY_REFUND_URL=

# ── URLs ────────────────────────────────────────────────────────────────────────
# Base des liens dans les emails (un href relatif est mort en client mail)
WEB_BASE_URL=http://localhost:3000

# ── Jobs planifiés ──────────────────────────────────────────────────────────────
# Mettre à 1 pour ne pas démarrer node-cron (utile en CI)
DISABLE_SCHEDULED_JOBS=

# --- Transport temps réel des lives (arbitrages 31, 38) ---
# Sans ces trois clés, l'agenda, les replays et la modération fonctionnent ;
# seule la diffusion est absente, et les écrans le disent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- SMS (arbitrage 24) ---
# Sans SMS_API_URL et SMS_API_KEY, les envois sont journalisés `[SMS:DEV]` au
# lieu d'échouer — même patron que RESEND_API_KEY.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=NkamVa
# Indicatif appliqué aux numéros saisis sans « + » (ex. +237).
SMS_DEFAULT_COUNTRY_CODE=

# ── Enregistrement et diffusion des replays (Mux) ──────────────────────────────
# LiveKit transporte le direct, Mux enregistre et rediffuse. Vide = repli sur un
# egress fichier vers le stockage objet ci-dessus.
# Un replay hébergé par Mux ne consomme PAS le quota du formateur (arbitrage 54).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Clé publique de Mux Data (mesure d'audience du lecteur). Non lue côté serveur.
MUX_ENV_KEY=

# ── Double authentification ────────────────────────────────────────────────────
# Le second facteur est une application (TOTP), pas un SMS : la plateforme porte
# des portefeuilles et des retraits, et l'échange de carte SIM vise précisément
# les comptes adossés au mobile money.
# Le secret TOTP est chiffré au repos avec une clé dérivée de NEXTAUTH_SECRET.
#
# Mettre à 1 pour REFUSER la connexion aux comptes d'administration qui ne l'ont
# pas activée. À n'activer qu'une fois vos administrateurs enrôlés : la
# contrainte les verrouillerait dehors, y compris celui qui devrait débloquer
# les autres.
REQUIRE_ADMIN_2FA=
